+  // T1 baseline instrumentation: scripted axis profile (env
+  // UNITREE_MUJOCO_SCRIPTED_COMMANDS) — identical class to the refactored
+  // tree's, so both binaries replay the same sim-time command profile.
+  class ScriptedJoystick : public unitree::common::UnitreeJoystick
+  {
+  public:
+    ScriptedJoystick(const std::string& profile_path,
+                     JoystickAxisFilter axis_filter)
+        : axis_filter_(std::move(axis_filter))
+    {
+      std::ifstream in(profile_path);
+      if (!in) { std::cerr << "ScriptedJoystick: cannot open profile " << profile_path << std::endl; exit(1); }
+      std::string line;
+      while (std::getline(in, line))
+      {
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream ss(line);
+        Point pt{};
+        if (ss >> pt.t >> pt.lx >> pt.ly >> pt.rx) points_.push_back(pt);
+      }
+      std::cout << "ScriptedJoystick: " << points_.size() << " breakpoints from " << profile_path << std::endl;
+      if (axis_filter_) { lx.smooth = 1.0f; ly.smooth = 1.0f; rx.smooth = 1.0f; }
+    }
+    void update() override
+    {
+      const double t = d ? d->time : 0.0;
+      std::array<float, 3> axes{0.0f, 0.0f, 0.0f};
+      for (const auto& pt : points_) { if (pt.t > t) break; axes = {pt.lx, pt.ly, pt.rx}; }
+      if (axis_filter_) axes = axis_filter_(axes[0], axes[1], axes[2]);
+      lx(axes[0]); ly(axes[1]); rx(axes[2]); ry(0.0f);
+    }
+  private:
+    struct Point { double t; float lx, ly, rx; };
+    std::vector<Point> points_;
+    JoystickAxisFilter axis_filter_;
+  };
+
+  std::unique_ptr<dpcbf_ros_adapter::FilterIoWriter> filter_io_log;
 } // namespace
 
