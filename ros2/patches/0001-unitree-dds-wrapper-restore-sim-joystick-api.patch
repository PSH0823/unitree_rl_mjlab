+// Common key state consumed generically (e.g. the deploy FSM's joystick DSL,
+// which also needs hold durations for chords like "L2(1s)").
+class KeyBase
+{
+public:
+  bool pressed = false;
+  bool on_pressed = false;
+  bool on_released = false;
+  double pressed_time = 0.0;  // seconds the current press has been held
+
+protected:
+  void touch(bool now_pressed)
+  {
+    on_pressed = (now_pressed && !pressed);
+    on_released = (!now_pressed && pressed);
+    if (on_pressed) press_start_ = std::chrono::steady_clock::now();
+    pressed = now_pressed;
+    pressed_time = pressed
+        ? std::chrono::duration<double>(
+              std::chrono::steady_clock::now() - press_start_).count()
+        : 0.0;
+  }
+
+private:
+  std::chrono::steady_clock::time_point press_start_{};
+};
