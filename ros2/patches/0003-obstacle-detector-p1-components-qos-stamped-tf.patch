diff --git a/src/obstacle_extractor_component.cpp b/src/obstacle_extractor_component.cpp
new file mode 100644
index 0000000..b3aa7f9
--- /dev/null
+++ b/src/obstacle_extractor_component.cpp
@@ -0,0 +1,30 @@
+/*
+ * Composable-node wrapper for ObstacleExtractor so it can be loaded into a
+ * component container (with intra-process comms) instead of running as a
+ * standalone process.
+ */
+
+#include "rclcpp/rclcpp.hpp"
+#include "rclcpp_components/register_node_macro.hpp"
+
+#include "obstacle_detector/obstacle_extractor.h"
+
+namespace obstacle_detector
+{
+
+class ObstacleExtractorComponent : public rclcpp::Node
+{
+public:
+  explicit ObstacleExtractorComponent(const rclcpp::NodeOptions & options)
+  : rclcpp::Node("obstacle_extractor", options)
+  {
+    impl_ = std::make_unique<ObstacleExtractor>(this, this);
+  }
+
+private:
+  std::unique_ptr<ObstacleExtractor> impl_;
+};
+
+}  // namespace obstacle_detector
+
+RCLCPP_COMPONENTS_REGISTER_NODE(obstacle_detector::ObstacleExtractorComponent)
