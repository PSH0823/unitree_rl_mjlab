+/*
+ * Composable-node wrapper for ObstacleTracker so it can be loaded into a
+ * component container (with intra-process comms) instead of running as a
+ * standalone process.
+ */
+
+#include "rclcpp/rclcpp.hpp"
+#include "rclcpp_components/register_node_macro.hpp"
+
+#include "obstacle_detector/obstacle_tracker.h"
+
+namespace obstacle_detector
+{
+
+class ObstacleTrackerComponent : public rclcpp::Node
+{
+public:
+  explicit ObstacleTrackerComponent(const rclcpp::NodeOptions & options)
+  : rclcpp::Node("obstacle_tracker", options)
+  {
+    impl_ = std::make_unique<ObstacleTracker>(this, this);
+  }
+
+private:
+  std::unique_ptr<ObstacleTracker> impl_;
+};
+
+}  // namespace obstacle_detector
+
+RCLCPP_COMPONENTS_REGISTER_NODE(obstacle_detector::ObstacleTrackerComponent)
