diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index bb98b35..c2b2e4c 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -29,6 +29,19 @@ target_include_directories(ddscxx INTERFACE
 ## Install targets
 file(GLOB DDS_LIBRARIES "${CMAKE_CURRENT_LIST_DIR}/lib/${CMAKE_SYSTEM_PROCESSOR}/*")
 
+# This workspace builds CycloneDDS 0.10.2 from source into the SAME merged
+# prefix, so installing the bundled copy of libddsc here makes two packages
+# race for the same three filenames. The layouts are incompatible:
+#   cyclonedds      libddsc.so -> libddsc.so.0 -> libddsc.so.0.10.2 (real)
+#   unitree_sdk2    libddsc.so (real) <- libddsc.so.0
+# Interleaved, the survivors are libddsc.so -> libddsc.so.0 -> libddsc.so, a
+# symlink loop that fails every later link with "Too many levels of symbolic
+# links". Both copies ARE CycloneDDS 0.10.2 and the source build defines every
+# symbol libunitree_sdk2.a (17) and libddscxx.so (154) need, so the source
+# build owns libddsc.* and only libddscxx.* — which has no source counterpart,
+# cyclonedds-cxx being COLCON_IGNOREd — is installed from here.
+list(FILTER DDS_LIBRARIES EXCLUDE REGEX "/libddsc\\.so")
+
 install(FILES ${DDS_LIBRARIES} DESTINATION ${CMAKE_INSTALL_LIBDIR})
 
 install(DIRECTORY ${CMAKE_CURRENT_LIST_DIR}/include/
