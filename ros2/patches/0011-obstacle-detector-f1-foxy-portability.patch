@@ -0,0 +1,70 @@
+/*
+ * ROS 2 distro compatibility shims for obstacle_detector.
+ *
+ * This fork has to build on BOTH:
+ *   - Humble (Ubuntu 22.04) — the development machine and the simulator
+ *   - Foxy   (Ubuntu 20.04) — the G1's onboard computer
+ *
+ * Nothing here changes behaviour on either distro; it only spells the same
+ * operation the way each rclcpp version accepts.
+ */
+
+#pragma once
+
+#include <string>
+
+#include "rclcpp/rclcpp.hpp"
+
+#if __has_include(<rclcpp/version.h>)
+#include "rclcpp/version.h"
+#endif
+
+// Node::declare_parameter(name, rclcpp::ParameterType) — declare a parameter
+// by TYPE with no default, so it stays unset unless an override is supplied —
+// arrived with rclcpp 16 (Humble). Foxy's rclcpp (2.4) has no version.h and no
+// such overload.
+// (Two nested #ifs, not `defined(X) && X(...)`: the preprocessor expands the
+// whole expression before evaluating it, so the call would be a syntax error
+// on the very distro where the macro is absent.)
+#ifdef RCLCPP_VERSION_GTE
+#  if RCLCPP_VERSION_GTE(16, 0, 0)
+#    define OBSTACLE_DETECTOR_HAS_TYPED_PARAM_DECL 1
+#  else
+#    define OBSTACLE_DETECTOR_HAS_TYPED_PARAM_DECL 0
+#  endif
+#else
+#  define OBSTACLE_DETECTOR_HAS_TYPED_PARAM_DECL 0
+#endif
+
+namespace obstacle_detector
+{
+
+/**
+ * Declare `name` with no default value.
+ *
+ * Humble: declared with the given static type, left unset.
+ * Foxy:   declared with an empty ParameterValue, i.e. PARAMETER_NOT_SET.
+ *
+ * Both leave the parameter UNSET when no override is given, which is what
+ * every call site relies on: the subsequent get_parameter_or(name, out, dflt)
+ * returns `dflt` exactly when the parameter was not overridden, because
+ * NodeParameters::get_parameter() reports false for a NOT_SET parameter on
+ * Foxy and for an unset statically-typed parameter on Humble.
+ *
+ * The only difference is later re-assignment: Humble rejects a set() of the
+ * wrong type, Foxy accepts it (parameters were dynamically typed before
+ * Humble). No node in this package re-types a parameter at runtime.
+ */
+template<typename NodeT>
+inline void declare_parameter_typed(
+  NodeT && nh, const std::string & name, rclcpp::ParameterType type)
+{
+#if OBSTACLE_DETECTOR_HAS_TYPED_PARAM_DECL
+  nh->declare_parameter(name, type);
+#else
+  (void)type;
+  nh->declare_parameter(name);
+#endif
+}
+
+}  // namespace obstacle_detector
