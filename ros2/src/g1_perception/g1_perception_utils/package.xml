<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_perception_utils</name>
  <version>0.1.0</version>
  <description>
    Small TF/visualization utilities (§6.3): base_footprint_publisher
    (odom->base_footprint = base_link projected to the ground plane),
    obstacles_marker_relay (obstacle_detector/Obstacles -> MarkerArray) and
    dpcbf_overlay (estimated-vs-GT obstacle overlay plus the DPCBF constraint
    geometry, §4.6 -- the sixth marker layer, alongside the four relays).
  </description>
  <maintainer email="joan0219@yonsei.ac.kr">Seohyeon Lim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>obstacle_detector</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>dpcbf_ros_adapter</depend>
  <!-- Already in the workspace: dpcbf, obstacle_detector and the ROS 2
       yaml_cpp_vendor all build against it. The overlay reads the same
       dpcbf_config.yaml the simulator loads rather than re-declaring the
       parameters as ROS defaults, which would let the two drift. -->
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
