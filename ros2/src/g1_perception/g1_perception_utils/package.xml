<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_perception_utils</name>
  <version>0.1.0</version>
  <description>
    Small TF/visualization utilities (§6.3): base_footprint_publisher
    (odom->base_footprint = base_link projected to the ground plane) and
    obstacles_marker_relay (obstacle_detector/Obstacles -> MarkerArray).
  </description>
  <maintainer email="joan0219@yonsei.ac.kr">Seohyeon Lim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>obstacle_detector</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
