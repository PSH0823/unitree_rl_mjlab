# Copy to ~/.g1_viz_env on EACH machine and fill in that machine's values.
# viz_env_computer2.sh / viz_env_computer3.sh source this file automatically.
# Nothing in the repo hardcodes an IP or an interface name — this file is
# where they live, per machine, outside version control.

# Shared by every machine on the visualization link (and by Computer 1's
# sensor topics if they use ROS): pick once, record it in the session log.
export G1_VIZ_DOMAIN_ID=7

# --- Computer 2 (G1 onboard PC) -------------------------------------------
# NIC toward Computer 3 (laptop network):
export G1_VIZ_IFACE=wlan0
# NIC toward Computer 1 (G1 blackbox / Mid-360 net), ONLY if different:
#export G1_SENSOR_IFACE=eth0
# static-peer mode only: the other end of each link
#export G1_VIZ_PEER=192.168.50.30       # Computer 3's IP
#export G1_SENSOR_PEER=192.168.123.120  # Computer 1's IP

# --- Computer 3 (operator laptop) -----------------------------------------
#export G1_VIZ_IFACE=wlp2s0
#export G1_VIZ_PEER=192.168.50.20       # Computer 2's IP (static mode)

# --- dev machines only ----------------------------------------------------
# Required before `source viz_env_computerN.sh localhost` will proceed:
#export G1_VIZ_ALLOW_LOCALHOST=1
